{
  "name": "paper-reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:real-papers": "node scripts/fetch-real-papers.mjs",
    "bench:pdf-extraction": "npx tsx scripts/benchmark-pdf-extraction.ts",
    "bench:real-paper-translation": "npx --yes tsx scripts/benchmark-real-paper-translation.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "verify:browser": "node scripts/verify-browser.mjs",
    "audit:prepare-review": "npx --yes tsx scripts/prepare-translation-manual-review.ts",
    "audit:summarize-review": "npx --yes tsx scripts/summarize-translation-manual-review.ts",
    "audit:run-pending": "node scripts/run-pending-translation-audit.mjs",
    "verify:real-paper-source-policy": "npx --yes tsx scripts/verify-real-paper-source-policy.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "lucide-react": "^1.39.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sql.js": "^1.14.2",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "fake-indexeddb": "^6.2.2",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  }
}
