{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paper Reader",
  "version": "0.1.0",
  "identifier": "com.harada.paper-reader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "bash scripts/bundle-python.sh && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Paper Reader",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* http://[::1]:*",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "media-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* http://[::1]:* ws://localhost:* ws://127.0.0.1:*",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "media-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval' http://localhost:5173 http://127.0.0.1:5173",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../translation-server": "translation-server"
    }
  }
}
